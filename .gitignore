# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Secrets
.env

# Local data
data/*.db
data/*.db-journal
data/tts/

# Arduino build output
arduino/**/build/

# OS / editor
.DS_Store
.vscode/
.idea/

# Half-written fallback mp3 from an interrupted pi/make_fallbacks.py run
assets/*.part
# Generated narrator clips (python pi/make_fallbacks.py): regenerate on each
# machine with your own ElevenLabs key instead of committing them.
assets/*.mp3

# Frontend (frontend/): dependencies and build output (npm run build -> frontend/dist,
# served by `python pi/main.py --ui`; rebuild it on each machine instead of committing it)
node_modules/
dist/
*.local

# Local AI-tool artifacts: never commit
.claude/
.claude-flow/
.claude*
.swarm/
ruvector.db

# Round 5 joke / question clips are generated per machine (pi/make_fallbacks.py --jokes)
assets/jokes/*.part
assets/jokes/*.mp3
