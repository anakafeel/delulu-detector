# Copy to .env (never commit .env) and fill in.
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# Any voice id from your ElevenLabs voice library (default below is the premade "George").
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = lowest latency; eleven_multilingual_v2 = higher quality.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Total seconds to wait for TTS. A failure is shown as "verdict unavailable".
ELEVENLABS_TIMEOUT_S=3

# Presage SmartSpectra. Put the key here. Do not commit this file.
# The official name is SMARTSPECTRA_API_KEY. PRESAGE_API_KEY is also read.
SMARTSPECTRA_API_KEY=

# Optional overrides
# DELULU_SERIAL_PORT=/dev/ttyACM0
# DELULU_DB_PATH=data/sessions.db
# DELULU_AUDIO_PLAYER=mpg123 -q
# Round 5 (Poker Face): webcam index (config POKER_CAMERA_INDEX, same as --camera; e.g. 2 for an
# external USB webcam) and, for OpenCV builds without
# cv2.data (e.g. apt's python3-opencv), where the Haar cascade XMLs are.
# DELULU_CAMERA_INDEX=0
# DELULU_CASCADE_DIR=/usr/share/opencv4/haarcascades

# Optional: Tiger Data (Timescale) copy of every scored round, for the calibration curve and
# leaderboard (pi/tiger_store.py). Use the service connection string, e.g.
# postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require. Empty = off.
TIGER_DATA_URL=
